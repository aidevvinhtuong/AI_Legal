# AI Legal — mẫu cấu hình. Copy thành .env rồi chỉnh.
#     cp .env.example .env
#
# .env KHÔNG được commit (đã có trong .gitignore).

# ── Môi trường ────────────────────────────────────────────────────────────
ENV=dev
DEBUG=true
# BẮT BUỘC đổi. Sinh chuỗi mới:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=doi-chuoi-nay-truoc-khi-chay-that-toi-thieu-16-ky-tu

# ── Cổng host ─────────────────────────────────────────────────────────────
# Máy dev đang có: PBI Analysis API ở 8000 và 8001, Airflow ở 8080.
# Đừng đổi về 8000 nếu chưa chắc cổng đó trống.
API_PORT=8010
POSTGRES_PORT=55432
REDIS_PORT=63790
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_USER=ailegal
POSTGRES_PASSWORD=ailegal
POSTGRES_DB=ailegal

# ── MinIO ─────────────────────────────────────────────────────────────────
S3_ACCESS_KEY=ailegal
S3_SECRET_KEY=ailegal-secret
S3_BUCKET=ailegal-documents

# ── Model: ĐÃ CÓ SẴN, backend chỉ gọi API ─────────────────────────────────
# Đã kiểm chứng 06/08/2026:  python3 scripts/check-llm.py
#
# CẢNH BÁO BẢO MẬT: đây là IP public và giao thức HTTP không mã hoá. Nội dung
# điều khoản hợp đồng sẽ đi qua Internet ở dạng rõ, trong khi ràng buộc C-1 /
# NFR-S1 yêu cầu dữ liệu không rời hạ tầng nội bộ. Nên đổi sang IP nội bộ hoặc
# đặt TLS trước 3 endpoint. Xem TS-12 mục II.4.

LLM_BASE_URL=http://171.244.136.217:8386/v1
LLM_MODEL=Qwen/Qwen3.6-27B
LLM_API_KEY=EMPTY

EMBED_BASE_URL=http://171.244.136.217:8387
EMBED_MODEL=AITeamVN/Vietnamese_Embedding
EMBED_DIM=1024

RERANK_BASE_URL=http://171.244.136.217:8389

# ── Van an toàn tài liệu ──────────────────────────────────────────────────
# Chỉ bật sau khi PoC-1 chứng minh ghi vào vùng bắc qua bảng không vỡ format.
ALLOW_CROSS_TABLE_WRITE=false

# ── FPT.eContract ─────────────────────────────────────────────────────────
# ĐỂ TRỐNG = chạy adapter mock: toàn bộ luồng nghiệp vụ, outbox, callback và
# đối soát vẫn hoạt động, chỉ không gọi ra ngoài. Có credentials môi trường
# Demo (câu hỏi mở D1e) thì điền vào đây, KHÔNG phải sửa code.
ECONTRACT_BASE_URL=https://demo.econtract.fpt.com/app
ECONTRACT_CLIENT_ID=
ECONTRACT_CLIENT_SECRET=
ECONTRACT_USERNAME=
ECONTRACT_PASSWORD=
# D1a / D1b chưa chốt — hai giá trị dưới là placeholder theo tài liệu FPT
ECONTRACT_SELECTOR=flow_start_AI_LEGAL_create_auto_determine_econtract_integrate
ECONTRACT_DOC_TYPE_CODE=2
# Khoá HMAC xác thực callback. Ở prod mà để trống thì MỌI callback bị từ chối —
# cố ý: không có khoá nghĩa là ai cũng đánh dấu được hợp đồng là "đã ký".
ECONTRACT_CALLBACK_SECRET=

# Bề rộng ô ký = số khoảng trắng giữa hai dấu `#`. Hệ số quy đổi px → space
# này CHƯA hiệu chuẩn; phải đo trên môi trường Demo của FPT (ca EC-07).
MARKER_PX_PER_SPACE=8.0

# ── Frontend ──────────────────────────────────────────────────────────────
# Đặt trong frontend/.env.local, KHÔNG phải file này:
#     NEXT_PUBLIC_API_URL=http://localhost:8010
